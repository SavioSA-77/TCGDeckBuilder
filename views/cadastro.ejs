<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro - TCG Deck Builder</title>
    <!-- Usamos o login.css para manter exatamente a mesma estilização (fundo, box-shadow, botões) -->
    <link rel="stylesheet" href="/stylesheets/login.css">
    <style>
        /* Ajuste simples para acomodar os campos extra do cadastro sem deformar a caixa */
        .card { padding-top: 20px; padding-bottom: 20px; }
        .input-group { margin-bottom: 12px; }
    </style>
</head>
<body>
    <main class="login-content">
        <!-- O cabeçalho usa a classe .pokebola definida no teu login.css -->
        <div class="header">
            <div class="pokebola"></div>
            <div class="title">TCG Deck Builder</div>
        </div>

        <form class="card" action="/cadastro" method="POST">
            
            <% if (typeof erro !== 'undefined' && erro) { %>
                <div style="background-color: #ffebee; color: #c62828; padding: 10px; border-radius: 4px; margin-bottom: 15px; text-align: center; font-size: 14px; font-weight: bold;">
                    <%= erro %>
                </div>
            <% } %>

            <div class="input-group">
                <label for="username">Nome de Usuário:</label>
                <input type="text" id="username" name="username" placeholder="Treinador123" required>
            </div>

            <div class="input-group">
                <label for="email">Email:</label>
                <input type="email" id="email" name="email" placeholder='"voce@mail.com"' required>
            </div>

            <div class="input-group">
                <label for="idade">Idade:</label>
                <input type="number" id="idade" name="idade" placeholder="Ex: 18" min="1" required>
            </div>

            <div class="input-group">
                <label for="senha">Senha:</label>
                <div class="password-container">
                    <input type="password" id="senha" name="senha" placeholder="Crie uma senha forte" required>
                </div>
            </div>

            <div class="input-group">
                <label for="confirmarSenha">Confirmar Senha:</label>
                <div class="password-container">
                    <input type="password" id="confirmarSenha" name="confirmarSenha" placeholder="Repita a senha" required>
                </div>
            </div>

            <button type="submit" class="btn btn-entrar" style="margin-top: 15px;">Cadastrar</button>

            <div class="footer">
                Já tem uma conta? <a href="/login">Entrar</a>
            </div>
        </form>
    </main>

    <script src="/javascripts/script.js"></script>
</body>
</html>