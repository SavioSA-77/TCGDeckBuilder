<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seus Decks - PokéBuilder</title>
    <!-- O caminho corrigido sem o /public -->
    <link rel="stylesheet" href="/stylesheets/home.css">
</head>
<body class="home-page">
    
    <!-- NAVBAR ATUALIZADA COM AS CLASSES DO HOME.CSS -->
    <header class="header-hex">
        <div class="header-logo-container-sm">
            <div class="pokebola-sm"></div>
            <h1 class="title-sm">PokéBuilder</h1>
        </div>
        <nav class="navbar-custom">
            <a href="/home" class="nav-btn <%= typeof paginaAtual !== 'undefined' && paginaAtual === 'home' ? 'ativo-amarelo' : '' %>">Decks</a>
            <a href="/seus-decks" class="nav-btn <%= typeof paginaAtual !== 'undefined' && paginaAtual === 'seus-decks' ? 'ativo-amarelo' : '' %>">Seus Decks</a>
            <a href="/criar-deck" class="nav-btn">+ Novo Deck</a>
        </nav>
    </header>

    <main class="catalog">
        <!-- TÍTULO MINIMALISTA -->
        <h2 class="titulo-minimalista">Seus times pokemon:</h2>

        <!-- GRID DE CARDS COM AS CLASSES DO HOME.CSS -->
        <div class="catalog-grid">
            <% if (typeof decks !== 'undefined' && decks.length > 0) { %>
                <% decks.forEach(function(deck) { %>
                    <div class="catalog-card">
                        <!-- Clique na imagem redireciona para a visualização das cartas -->
                        <a href="/deck/<%= deck.id %>" style="text-decoration: none; color: inherit; display: block;">
                            <div class="catalog-card__image deck-cover-container">
                                <!-- Exibe as cartas dos Pokémons principais em leque -->
                                <% if (typeof deck.imagensCapa !== 'undefined' && deck.imagensCapa.length > 0) { %>
                                    <div class="deck-cover-list">
                                        <% deck.imagensCapa.forEach(function(img, index) { %>
                                            <img src="<%= img %>" alt="Pokémon Principal"
                                                 class="deck-cover-image <%= deck.imagensCapa.length > 1 ? 'deck-cover-image-multiple' : '' %> <%= index > 0 ? 'deck-cover-image-overlap' : '' %>">
                                        <% }); %>
                                    </div>
                                <% } else { %>
                                    <img src="<%= deck.imagemCapa || 'https://tcg.pokemon.com/assets/img/global/tcg-card-back-2x.jpg' %>" alt="Capa de <%= deck.nome %>" style="border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.2); object-fit: cover; object-position: top; width: 100%;">
                                <% } %>
                            </div>
                        </a>
                        <div class="catalog-card__name" style="justify-content: space-between; padding: 12px 16px;">
                            <span style="font-weight: bold; font-size: 16px;"><%= deck.nome %></span>
                            <a href="/editar-deck/<%= deck.id %>" class="nav-btn" style="padding: 5px 10px; font-size: 12px;">Editar</a>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="sem-decks" style="grid-column: span 4; text-align: center; padding: 40px;">
                    <p>Ainda não criaste nenhum deck.</p>
                    <br>
                    <a href="/criar-deck" class="nav-btn">Criar o meu primeiro deck</a>
                </div>
            <% } %>
        </div>
    </main>

    <footer class="home-footer">
        <div>© 2024 PokéBuilder</div>
        <div>Construa o seu time perfeito</div>
    </footer>
</body>
</html>