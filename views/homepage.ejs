<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comunidade - PokéBuilder</title>
    <!-- O caminho correto para o CSS -->
    <link rel="stylesheet" href="/stylesheets/home.css">
</head>
<body class="home-page">
    
    <!-- NAVBAR ATUALIZADA COM AS CLASSES DO HOME.CSS -->
    <header class="header-hex">
        <div class="header-logo-container-sm">
            <div class="pokebola-sm"></div>
            <h1 class="title-sm">PokéBuilder</h1>
        </div>
        <nav class="navbar-custom">
            <a href="/home" class="nav-btn <%= typeof paginaAtual !== 'undefined' && paginaAtual === 'home' ? 'ativo-amarelo' : '' %>">Decks</a>
            <a href="/seus-decks" class="nav-btn <%= typeof paginaAtual !== 'undefined' && paginaAtual === 'seus-decks' ? 'ativo-amarelo' : '' %>">Seus Decks</a>
            <a href="/criar-deck" class="nav-btn">+ Novo Deck</a>
        </nav>
    </header>

    <main class="catalog">
        <!-- ÁREA DE DESTAQUE / FILTROS DA COMUNIDADE -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <h2 class="titulo-minimalista" style="margin: 0;">Decks da Comunidade</h2>
            <div class="filtros">
                <button class="nav-btn sort-favoritos-btn" type="button" aria-pressed="false" style="cursor: pointer;">Ordenar por Favoritos ⭐</button>
            </div>
        </div>

        <!-- GRID DE CARDS COM AS CLASSES DO HOME.CSS -->
        <div class="catalog-grid">
            <% if (typeof decks !== 'undefined' && decks.length > 0) { %>
                <% decks.forEach(function(deck) { %>
                    <div class="catalog-card">
                        <div class="catalog-card__image">
                            <img src="<%= deck.imagemCapa || '/images/card-back.png' %>" alt="Capa de <%= deck.nome %>">
                        </div>
                        
                        <!-- Bloco de informações adaptado para incluir Autor e Favoritos de forma elegante -->
                        <div class="catalog-card__name" style="flex-direction: column; align-items: flex-start; justify-content: center; padding: 12px 16px;">
                            <span style="font-weight: bold; font-size: 16px; margin-bottom: 4px;"><%= deck.nome %></span>
                            <span style="font-size: 12px; color: #5f6863;">Criado por: <%= deck.autor || 'Anónimo' %></span>
                            <span style="font-size: 12px; color: #5f6863; margin-top: 4px;">⭐ <%= deck.favoritos || 0 %> Favoritos</span>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="sem-decks" style="grid-column: span 4; text-align: center; padding: 40px;">
                    <p>Nenhum deck encontrado na comunidade.</p>
                </div>
            <% } %>
        </div>
    </main>

    <footer class="home-footer">
        <div>© 2024 PokéBuilder</div>
        <div>Construa o seu time perfeito</div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const btn = document.querySelector('.sort-favoritos-btn');
            if (!btn) return;

            btn.addEventListener('click', function () {
                const isActive = btn.classList.toggle('ativo');
                btn.setAttribute('aria-pressed', String(isActive));
            });
        });
    </script>
</body>
</html>