<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Metagame - PokéBuilder</title>
    <link rel="stylesheet" href="/stylesheets/home.css">
    <style>
        /* Transformar o card num link clicável mantendo o design */
        .card-link { text-decoration: none; color: inherit; display: block; }
    </style>
</head>
<body class="home-page">
    
    <header class="header-hex">
        <div class="header-logo-container-sm">
            <div class="pokebola-sm"></div>
            <h1 class="title-sm">PokéBuilder</h1>
        </div>
        <nav class="navbar-custom">
            <a href="/home" class="nav-btn ativo-amarelo">Decks</a>
            <a href="/seus-decks" class="nav-btn">Seus Decks</a>
            <a href="/criar-deck" class="nav-btn">+ Novo Deck</a>
            <a href="/logout" class="nav-btn">Sair</a>
        </nav>
    </header>

    <main class="catalog">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <h2 class="titulo-minimalista" style="margin: 0;">Escolha um Pokémon</h2>
        </div>

        <div class="catalog-grid">
            <% if (typeof pokemons !== 'undefined' && pokemons.length > 0) { %>
                <% pokemons.forEach(function(pokemon) { %>
                    <!-- Ao clicar, vai para a rota dos decks daquele pokemon -->
                    <a href="/pokemon/<%= pokemon.id %>" class="card-link">
                        <div class="catalog-card">
                            <div class="catalog-card__image" style="background: transparent; padding: 10px;">
                                <!-- Mostra a carta do Pokémon -->
                               <img src="<%= pokemon.imagem %>" alt="<%= pokemon.nome %>" style="border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.2); object-fit: cover; object-position: top;">
                            </div>
                            <div class="catalog-card__name" style="justify-content: center;">
                                <span style="font-weight: bold; font-size: 18px;"><%= pokemon.nome %></span>
                            </div>
                        </div>
                    </a>
                <% }); %>
            <% } else { %>
                <div class="sem-decks" style="grid-column: span 4; text-align: center; padding: 40px;">
                    <p>Nenhum Pokémon encontrado. Adicione um deck no Compass!</p>
                </div>
            <% } %>
        </div>
    </main>

    <footer class="home-footer">
        <div>© 2024 PokéBuilder</div>
        <div>Construa o seu time perfeito</div>
    </footer>
</body>
</html>