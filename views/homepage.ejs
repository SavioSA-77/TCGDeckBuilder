<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- O Bootstrap continua aqui caso precises dele para outros elementos -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/home.css">
</head>
<body class="home-page">

    <!-- === NOVO CABEÇALHO (FAIXA HEXAGONAL) === -->
    <header class="header-hex">
        <!-- Lado Esquerdo: Logo e Título -->
        <div class="header-logo-container-sm">
            <div class="pokebola-sm"></div>
            <h1 class="title-sm">TCG Deck Builder</h1>
        </div>

        <!-- Lado Direito: Os 3 botões solicitados -->
        <nav class="navbar-custom">
            <a href="/" class="nav-btn">Decks</a>
            <a href="/seus-decks" class="nav-btn">Seus decks</a>
            <a href="/criar-deck" class="nav-btn">Criar deck</a>
        </nav>
    </header>
    <!-- === FIM DO CABEÇALHO === -->

    <!-- === CONTEÚDO PRINCIPAL (GRADE DE CARTAS) === -->
    <main class="catalog" aria-label="Coleção de cartas">
        <section class="catalog-grid">
            <% cards.forEach(function(card) { %>
                <article class="catalog-card">
                    <div class="catalog-card__image">
                        <% if (card.image) { %>
                            <img src="<%= card.image %>" alt="<%= card.name || '' %>">
                        <% } %>
                    </div>
                    <div class="catalog-card__name">
                        <% if (card.name) { %><span><%= card.name %></span><% } %>
                    </div>
                </article>
            <% }); %>
        </section>
    </main>

    <!-- === RODAPÉ === -->
    <footer class="home-footer">
        <span>TCG Deck Builder</span>
        <span>Criado em 30/09/2026</span>
    </footer>

</body>
</html>