<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Decks de <%= pokemonDestaque %> - PokéBuilder</title>
    <link rel="stylesheet" href="/stylesheets/home.css">
    <link rel="stylesheet" href="/stylesheets/variantes.css">
</head>
<body class="home-page retro-bg">

    <%- include('partials/navbar') %>

    <main class="catalog">
        <div class="page-title-row">
            <h2 class="titulo-minimalista page-title">Decks de <%= pokemonDestaque %></h2>
            <a href="/home" class="nav-btn" style="background-color: #e5e8e6; color: #333; border: 1px solid #ccc;">← Voltar</a>
        </div>

        <div class="catalog-grid">
            <% if (typeof decks !== 'undefined' && decks.length > 0) { %>
                <% decks.forEach(function(deck) { %>
                    <a href="/deck/<%= deck.id %>" class="card-link">
                        <div class="catalog-card">
                            <div class="catalog-card__image deck-cover-container">
                                <% if (typeof deck.imagensCapa !== 'undefined' && deck.imagensCapa.length > 0) { %>
                                    <div class="deck-cover-list">
                                        <% deck.imagensCapa.forEach(function(img, index) { %>
                                            <img src="<%= img %>" alt="Pokémon Principal"
                                                 class="deck-cover-image <%= deck.imagensCapa.length > 1 ? 'deck-cover-image-multiple' : '' %> <%= index > 0 ? 'deck-cover-image-overlap' : '' %>">
                                        <% }); %>
                                    </div>
                                <% } else { %>
                                    <img src="<%= deck.imagemCapa || 'https://tcg.pokemon.com/assets/img/global/tcg-card-back-2x.jpg' %>" alt="Capa" class="deck-cover-image-fallback">
                                <% } %>
                            </div>
                            <div class="catalog-card__name" style="flex-direction: column; align-items: center; justify-content: center; padding: 12px 16px;">
                                <span class="deck-name-frame"><%= deck.nome %></span>
                                <span style="font-size: 12px; color: #5f6863;">Criado por: <%= deck.autor %></span>
                            </div>
                        </div>
                    </a>
                <% }); %>
            <% } else { %>
                <div class="sem-decks" style="grid-column: span 4; text-align: center; padding: 40px;">
                    <p>Nenhum deck encontrado para este Pokémon.</p>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>